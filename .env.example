# 網站正式網址，用於 metadata / sitemap / OG 圖片等絕對路徑組成
# 未設定時預設為 https://dailyval.com
NEXT_PUBLIC_BASE_URL=https://dailyval.com

# /creators 頁面申請表單送出用的 Google Apps Script webhook URL
# 未設定時表單送出會直接顯示錯誤訊息
NEXT_PUBLIC_CREATOR_FORM_ENDPOINT=

# /account-deletion 頁面刪除申請表單的 webhook URL（同上為 Apps Script）
NEXT_PUBLIC_DELETION_FORM_ENDPOINT=

# CloudKit（造型評分）：伺服器端匿名讀取用的 Web API token
# 與 dailyval_social 用同一個 container；token 在 CloudKit Console 產生
APPLE_CK_CONTAINER_ID=iCloud.Kr1s.Valorant
APPLE_CK_API_TOKEN=
APPLE_CK_ENVIRONMENT=production

# 電競評分的網頁版 Sign in with Apple：Apple Developer 上的 Services ID
# （需在 Supabase Apple provider 的 Authorized Client IDs 一併加入）
NEXT_PUBLIC_APPLE_SERVICES_ID=

# 亮回覆門檻（預設 3；iOS 走 Firebase RC 的 esports_hot_min_likes）
NEXT_PUBLIC_ESPORTS_HOT_MIN_LIKES=

# 造型評分的網頁寫入開關（預設關閉）。等 Supabase 遷移的後端上線後
# 設 true；在那之前造型分頁為唯讀瀏覽＋App CTA
NEXT_PUBLIC_SKIN_VOTING_ENABLED=
